# Copy to .env.local for local development. Netlify reads the same names from
# its build environment (Site settings -> Environment variables).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, which
# is what a static export needs — but it also means they are public. Never put
# a secret behind a NEXT_PUBLIC_ name.

# Where the "Report a bug / Send feedback" link sends mail. This address is
# published in the page source of every page and WILL be scraped, which is why
# it is a dedicated account rather than a personal mailbox.
# Falls back to the same address in src/lib/site.ts when unset, so setting this
# is only needed to point feedback somewhere else.
NEXT_PUBLIC_FEEDBACK_EMAIL=cargridgame@gmail.com
